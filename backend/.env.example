# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Runtime — used starting Step 1
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API from a browser.
# Leave empty in early local development; set it once the frontend is served
# from a real origin. Never use a wildcard in production (see docs/API.md
# and Section 24 of the Final Specification).
CORS_ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database — used by the migration/seed scripts (Step 2) AND now by the
# running app itself (Step 3), which is why these are required at boot.
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crm_dev
DB_USER=root
DB_PASSWORD=
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Auth — required as of Step 3 (Google Sign-In + JWT sessions).
# ---------------------------------------------------------------------------

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0
# Client ID (Web application). This is also read by the frontend, so it is
# not itself a secret in the traditional sense, but the value must still
# match a real, configured Google OAuth client for sign-in to work.
GOOGLE_CLIENT_ID=

# Two independent, random, high-entropy strings. JWT_ACCESS_SECRET signs
# access tokens; JWT_REFRESH_SECRET is used as the HMAC key that hashes
# refresh tokens before they're stored (refresh tokens are opaque random
# values, not JWTs — see docs/ENVIRONMENT.md). Generate with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Used for Meta token-at-rest encryption (AES-256-GCM), required as of
# Step 7. Must decode to exactly 32 bytes — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Meta (Lead Ads) — required as of Step 7.
# ---------------------------------------------------------------------------

# From developers.facebook.com -> your App -> Settings -> Basic.
META_APP_ID=
META_APP_SECRET=

# NOT issued by Meta — an arbitrary string you choose yourself and enter
# into the App Dashboard's Webhooks config; Meta echoes it back on the GET
# verification handshake so we can confirm the subscription request came
# from our own dashboard setup, not a stranger. Generate any random string.
META_WEBHOOK_VERIFY_TOKEN=

# Optional — both have sane defaults (see backend/src/config/index.js) and
# do not need to be set for the app to boot.
# META_GRAPH_API_VERSION=v19.0
# META_REDIRECT_URI=http://localhost:4000/api/meta/oauth/callback

# ---------------------------------------------------------------------------
# Razorpay — not used yet.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
