# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Runtime — used starting Step 1
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API from a browser.
# Leave empty in early local development; set it once the frontend is served
# from a real origin. Never use a wildcard in production (see docs/API.md
# and Section 24 of the Final Specification).
CORS_ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database — not used yet. Added when the schema is implemented (Step 2+).
# ---------------------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Auth — not used yet. Added when Google Sign-In is implemented.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Meta (Lead Ads + Conversions API) — not used yet.
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# Razorpay — not used yet.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
