# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Runtime — used starting Step 1
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API from a browser.
# Leave empty in early local development; set it once the frontend is served
# from a real origin. Never use a wildcard in production (see docs/API.md
# and Section 24 of the Final Specification).
CORS_ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database — used by the migration/seed scripts (Step 2) AND now by the
# running app itself (Step 3), which is why these are required at boot.
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crm_dev
DB_USER=root
DB_PASSWORD=
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# Auth — required as of Step 3 (Google Sign-In + JWT sessions).
# ---------------------------------------------------------------------------

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0
# Client ID (Web application). This is also read by the frontend, so it is
# not itself a secret in the traditional sense, but the value must still
# match a real, configured Google OAuth client for sign-in to work.
GOOGLE_CLIENT_ID=

# Two independent, random, high-entropy strings. JWT_ACCESS_SECRET signs
# access tokens; JWT_REFRESH_SECRET is used as the HMAC key that hashes
# refresh tokens before they're stored (refresh tokens are opaque random
# values, not JWTs — see docs/ENVIRONMENT.md). Generate with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Used for Meta token-at-rest encryption (AES-256-GCM), required as of
# Step 7. Must decode to exactly 32 bytes — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Meta (Lead Ads) — required as of Step 7.
# ---------------------------------------------------------------------------

# From developers.facebook.com -> your App -> Settings -> Basic.
META_APP_ID=
META_APP_SECRET=

# NOT issued by Meta — an arbitrary string you choose yourself and enter
# into the App Dashboard's Webhooks config; Meta echoes it back on the GET
# verification handshake so we can confirm the subscription request came
# from our own dashboard setup, not a stranger. Generate any random string.
META_WEBHOOK_VERIFY_TOKEN=

# Optional — both have sane defaults (see backend/src/config/index.js) and
# do not need to be set for the app to boot.
# META_GRAPH_API_VERSION=v19.0
# META_REDIRECT_URI=http://localhost:4000/api/meta/oauth/callback

# ---------------------------------------------------------------------------
# Razorpay — required as of Step 9.
# ---------------------------------------------------------------------------

# From the Razorpay Dashboard -> Settings -> API Keys (Test Mode for local dev).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# NOT the same as RAZORPAY_KEY_SECRET — a separate value you set when
# configuring the webhook itself (Dashboard -> Settings -> Webhooks).
# Verifies X-Razorpay-Signature; generate any random string for local dev.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Agency Razorpay Connect (Technology Partner OAuth) — optional. A SEPARATE
# credential set from RAZORPAY_KEY_ID/SECRET above, which stays the
# platform's own account for Agency subscription billing only. Leave these
# unset in any environment that doesn't need the "Connect Razorpay" Agency
# feature yet — the app boots fine without them; only that one feature
# returns a clear 503 until configured (see config/index.js).
# ---------------------------------------------------------------------------

# From the Razorpay Partner Dashboard -> your Technology Partner app ->
# Keys. Distinct from the platform's own RAZORPAY_KEY_ID/SECRET.
RAZORPAY_PARTNER_CLIENT_ID=
RAZORPAY_PARTNER_CLIENT_SECRET=

# Must exactly match the redirect URI registered for this app on the
# Razorpay Partner Dashboard. Optional — defaults to
# {APP_URL}/api/agency-razorpay/oauth/callback (see config/index.js).
# RAZORPAY_PARTNER_REDIRECT_URI=http://localhost:4000/api/agency-razorpay/oauth/callback

# A separate secret from RAZORPAY_WEBHOOK_SECRET — Razorpay's
# application-level Partner webhooks (account.app.authorization_revoked)
# are configured independently per Partner app, each with its own secret.
# Set this to whatever you configure in the Partner Dashboard for this
# app's webhook.
RAZORPAY_PARTNER_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Scheduler infrastructure — optional, required as of Step 9A only if you
# want it running. No business jobs are registered yet (see
# backend/src/jobs/index.js), so it's safe to leave disabled; the app
# boots and behaves identically either way.
# ---------------------------------------------------------------------------

# "true" to start the in-process job scheduler on boot. Anything else
# (including unset) leaves it off.
SCHEDULER_ENABLED=false

# How often (ms) the scheduler polls registered jobs to see if they're
# due. Optional — defaults to 60000 (see backend/src/config/index.js).
# SCHEDULER_TICK_INTERVAL_MS=60000

# How often (ms) each Client renewal/grace job (Step 9B) is due to run.
# Optional — defaults to 3600000 (1 hour).
# CLIENT_RENEWAL_JOB_INTERVAL_MS=3600000

# How often (ms) the employee-invitation-expiry job (Step 11B) runs.
# Optional — defaults to 3600000 (1 hour).
# EMPLOYEE_INVITATION_EXPIRY_JOB_INTERVAL_MS=3600000
