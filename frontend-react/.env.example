# Runtime configuration — mirrors the old frontend's config.js. Nothing
# here is a secret: VITE_GOOGLE_CLIENT_ID is a public OAuth client id (Google
# Identity Services expects the browser to have it), VITE_RAZORPAY_KEY_ID is
# likewise Razorpay's public key (Checkout.js runs with it in the browser —
# the matching key_secret never leaves the backend), and VITE_API_BASE_URL
# is just where this environment's backend lives. Vite only exposes env vars
# prefixed VITE_ to client code, by design.
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=
VITE_RAZORPAY_KEY_ID=
